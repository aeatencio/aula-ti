---
import PizarronLayout from "../../layouts/PizarronLayout.astro";
---

<PizarronLayout
  title="Hilos y agentes"
  description="Pizarrón sobre dos formas de trabajar con IA: un hilo avanza de a uno; un agente encadena acciones hacia un objetivo."
  categoria="Pensamiento Computacional"
  encabezado="simple-grande"
>
  <p class="bajada" slot="encabezado-extra">Dos formas de trabajar con IA</p>

  <figure
    class="comparacion"
    aria-label="Un hilo avanza de a uno: la persona pide, la IA responde, la persona sigue. Un agente recibe un objetivo y entra en un ciclo: observa, actúa, verifica y vuelve a observar. Las dos formas pueden producir texto, imágenes, código o archivos."
  >
    <section class="modo" aria-labelledby="hilo-nombre">
      <h2 id="hilo-nombre" class="modo-nombre">Hilo</h2>
      <p class="modo-idea">Avanzamos de a uno</p>

      <div class="cadena">
        <div class="paso">
          <p class="paso-clave">Persona</p>
          <p class="paso-texto">Pide</p>
        </div>
        <div class="flecha" aria-hidden="true">
          <svg viewBox="0 0 48 24" focusable="false">
            <path d="M2 12h38M31 4l13 8-13 8"></path>
          </svg>
        </div>
        <div class="paso paso-maquina">
          <p class="paso-clave">IA</p>
          <p class="paso-texto">Responde</p>
        </div>
        <div class="flecha" aria-hidden="true">
          <svg viewBox="0 0 48 24" focusable="false">
            <path d="M2 12h38M31 4l13 8-13 8"></path>
          </svg>
        </div>
        <div class="paso">
          <p class="paso-clave">Persona</p>
          <p class="paso-texto">Sigue</p>
        </div>
        <div class="flecha" aria-hidden="true">
          <svg viewBox="0 0 48 24" focusable="false">
            <path d="M2 12h38M31 4l13 8-13 8"></path>
          </svg>
        </div>
        <div class="paso paso-maquina">
          <p class="paso-clave">IA</p>
          <p class="paso-texto">Responde</p>
        </div>
      </div>
    </section>

    <section class="modo" aria-labelledby="agente-nombre">
      <h2 id="agente-nombre" class="modo-nombre">Agente</h2>
      <p class="modo-idea">Encadena acciones hacia un objetivo</p>

      <div class="cadena">
        <div class="paso">
          <p class="paso-clave">Objetivo</p>
          <p class="paso-texto">Qué hay que lograr</p>
        </div>
        <div class="flecha" aria-hidden="true">
          <svg viewBox="0 0 48 24" focusable="false">
            <path d="M2 12h38M31 4l13 8-13 8"></path>
          </svg>
        </div>
        <div
          class="ciclo"
          role="group"
          aria-label="Ciclo: observa, actúa, verifica y vuelve a observar"
        >
          <div class="paso ciclo-observa">
            <p class="paso-clave">Observa</p>
            <p class="paso-texto">Mira la situación</p>
          </div>
          <div class="flecha ciclo-f1" aria-hidden="true">
            <svg viewBox="0 0 48 24" focusable="false">
              <path d="M2 12h38M31 4l13 8-13 8"></path>
            </svg>
          </div>
          <div class="paso paso-maquina ciclo-actua">
            <p class="paso-clave">Actúa</p>
            <p class="paso-texto">Da un paso</p>
          </div>
          <div class="flecha ciclo-f2" aria-hidden="true">
            <svg viewBox="0 0 48 24" focusable="false">
              <path d="M2 12h38M31 4l13 8-13 8"></path>
            </svg>
          </div>
          <div class="paso ciclo-verifica">
            <p class="paso-clave">Verifica</p>
            <p class="paso-texto">Mira qué pasó y decide</p>
          </div>

          <svg
            class="ciclo-arco"
            viewBox="0 0 108 200"
            preserveAspectRatio="none"
            focusable="false"
            aria-hidden="true"
          >
            <path
              d="M36 27 H100 V173 H0"
              vector-effect="non-scaling-stroke"
            ></path>
            <svg
              x="0"
              y="15"
              width="40"
              height="24"
              viewBox="0 0 48 24"
              preserveAspectRatio="xMinYMid meet"
            >
              <path
                d="M46 12 H10 M21 4 L6 12 L21 20"
                vector-effect="non-scaling-stroke"
              ></path>
            </svg>
          </svg>
          <p class="ciclo-leyenda">vuelve a observar</p>
        </div>
      </div>
    </section>
  </figure>

  <p class="productos">
    Ambos pueden producir texto, imágenes, código o archivos.
  </p>

  <p class="cierre">
    Las dos formas sirven para pensar y para producir. Cambia quién conduce
    cada paso.
  </p>

  <p class="continuar">
    <a href="/hilos-agentes-y-arneses/">Leer la explicación completa</a>
  </p>
</PizarronLayout>

<style>
  .bajada {
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 0.35vw + 0.98rem, 1.25rem);
    font-weight: 700;
    line-height: 1.35;
  }

  .comparacion {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2rem;
    margin: 0;
    padding: 1.35rem 0 1.5rem;
    border-top: 2px solid var(--line);
    border-bottom: 2px solid var(--line);
  }

  .modo {
    min-width: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .modo-nombre {
    margin: 0 0 0.35rem;
    text-align: center;
    font-size: clamp(1.35rem, 0.7vw + 1.15rem, 1.75rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.15;
  }

  .modo-idea {
    margin: 0 0 1rem;
    text-align: center;
    color: var(--muted);
    font-size: clamp(1.02rem, 0.25vw + 0.95rem, 1.18rem);
    font-weight: 700;
    line-height: 1.3;
  }

  .cadena {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    flex: 1;
    margin: 0;
    padding: 0;
  }

  .ciclo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4.4rem 1.95rem;
    grid-template-rows: auto auto auto auto auto;
    align-items: stretch;
    column-gap: 0.15rem;
  }

  .ciclo-observa {
    grid-area: 1 / 1;
  }

  .ciclo-f1 {
    grid-area: 2 / 1;
  }

  .ciclo-actua {
    grid-area: 3 / 1;
  }

  .ciclo-f2 {
    grid-area: 4 / 1;
  }

  .ciclo-verifica {
    grid-area: 5 / 1;
  }

  .ciclo .paso {
    min-height: 5.4rem;
  }

  .ciclo .flecha {
    min-height: 1.9rem;
  }

  .ciclo-arco {
    grid-area: 1 / 2 / 6 / 4;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.4;
    stroke-linecap: square;
    stroke-linejoin: miter;
    pointer-events: none;
  }

  .ciclo-arco path {
    fill: none;
  }

  .ciclo-leyenda {
    grid-area: 1 / 2 / 6 / 3;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0 0.15rem;
    text-align: center;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.25;
  }

  .paso {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 5.4rem;
    padding: 0.75rem 0.85rem;
    border: 2px solid var(--line);
    text-align: center;
  }

  .paso-clave {
    margin: 0 0 0.3rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .paso-texto {
    margin: 0;
    font-size: clamp(1.08rem, 0.3vw + 1rem, 1.28rem);
    font-weight: 700;
    line-height: 1.25;
  }

  .paso-maquina {
    background: var(--accent);
    color: var(--board);
    border-color: var(--accent);
  }

  .paso-maquina .paso-clave {
    color: color-mix(in srgb, var(--board) 82%, var(--accent));
  }

  .flecha {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 1.85rem;
    transform: rotate(90deg);
  }

  .flecha svg {
    width: 2.4rem;
    height: 1.25rem;
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.4;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .productos {
    margin: 1.35rem 0 0;
    text-align: center;
    color: var(--muted);
    font-size: clamp(1.02rem, 0.25vw + 0.95rem, 1.18rem);
    font-weight: 700;
    line-height: 1.35;
  }

  .cierre {
    margin: 1.1rem 0 0;
    font-size: clamp(1.08rem, 0.35vw + 1rem, 1.28rem);
    font-weight: 700;
    line-height: 1.4;
  }

  .continuar {
    margin: 1.5rem 0 0;
    font-size: 0.98rem;
    font-weight: 600;
  }

  .continuar a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
  }

  .continuar a:hover {
    color: var(--accent);
  }

  @media (max-width: 44rem) {
    .comparacion {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .modo + .modo {
      padding-top: 1.5rem;
      border-top: 2px solid var(--line);
    }

    .paso {
      min-height: 0;
    }

    .ciclo .paso {
      min-height: 5.4rem;
    }

    .ciclo {
      grid-template-columns: minmax(0, 1fr) 4rem 1.8rem;
    }
  }
</style>
