---
import {
  hrefConRecorrido,
  requireRecorrido,
} from "../../../data/recorridos";
import Layout from "../../../layouts/Layout.astro";

const recorrido = requireRecorrido("cfp7-si-2026");
---

<Layout
  title={`${recorrido.nombre} · Aula TI`}
  description="Pizarrones del recorrido de Sistemas Informáticos en CFP 7 durante 2026."
  current="escuelas"
>
  <p class="ubicacion-recorrido">Escuelas · CFP 7</p>
  <h1 class="page-title">{recorrido.nombre}</h1>
  <p class="lede">
    Pizarrones vistos en esta escuela durante este período.
  </p>

  <ol class="lista-pizarrones">
    {recorrido.pizarrones.map((pizarron) => (
      <li>
        <a href={hrefConRecorrido(pizarron.href, recorrido.id)}>
          {pizarron.title}
        </a>
      </li>
    ))}
  </ol>
</Layout>

<style>
  .ubicacion-recorrido {
    margin: 0 0 0.45rem;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .lista-pizarrones {
    list-style: decimal;
    padding-left: 1.7rem;
  }

  .lista-pizarrones li::marker {
    color: var(--muted);
    font-weight: 700;
  }
</style>
