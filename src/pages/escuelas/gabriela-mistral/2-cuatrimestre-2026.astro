---
import Layout from "../../../layouts/Layout.astro";

const pizarrones = [
  {
    href: "/pizarrones/preguntas-y-conceptos-principales/",
    title: "Preguntas y conceptos principales",
  },
  {
    href: "/pizarrones/hardware-software-y-tarea/",
    title: "Sistemas digitales: hardware y software",
  },
  {
    href: "/pizarrones/instrucciones-datos-operaciones-y-resultados/",
    title: "Instrucciones, datos, operaciones y resultados",
  },
  {
    href: "/pizarrones/entrada-procesamiento-y-salida/",
    title: "Entrada, procesamiento y salida",
  },
  {
    href: "/pizarrones/procesador-y-memoria-durante-la-ejecucion/",
    title: "Procesador y memoria durante la ejecución",
  },
  {
    href: "/pizarrones/el-estado-de-un-sistema/",
    title: "El estado de un sistema",
  },
  {
    href: "/pizarrones/el-sistema-operativo/",
    title: "El sistema operativo",
  },
];
---

<Layout
  title="Gabriela Mistral · 2.º cuatrimestre 2026 · Aula TI"
  description="Pizarrones del recorrido de Gabriela Mistral en el segundo cuatrimestre de 2026."
  current="escuelas"
>
  <p class="ubicacion-recorrido">Escuelas · Gabriela Mistral</p>
  <h1 class="page-title">Gabriela Mistral · 2.º cuatrimestre 2026</h1>
  <p class="lede">
    Pizarrones vistos en esta escuela durante este período.
  </p>

  <ol class="lista-pizarrones">
    {pizarrones.map((pizarron) => (
      <li>
        <a href={pizarron.href}>{pizarron.title}</a>
      </li>
    ))}
  </ol>
</Layout>

<style>
  .ubicacion-recorrido {
    margin: 0 0 0.45rem;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .lista-pizarrones {
    list-style: decimal;
    padding-left: 1.7rem;
  }

  .lista-pizarrones li::marker {
    color: var(--muted);
    font-weight: 700;
  }
</style>
