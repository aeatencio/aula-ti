---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  current?: "home" | "pizarrones" | "escuelas";
}

const {
  title,
  description = "Materiales docentes de Tecnologías de la Información.",
  current,
} = Astro.props;

const site = Astro.site;
if (!site) {
  throw new Error("Falta site en astro.config.mjs");
}

const canonicalURL = new URL(Astro.url.pathname, site);
const socialImageURL = new URL("/og.png", site);
const socialImageAlt = "Aula";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={socialImageURL.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:site_name" content="Aula" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL.href} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <a class="marca" href="/">Aula</a>
      <nav class="site-nav" aria-label="Principal">
        <a href="/pizarrones/" aria-current={current === "pizarrones" ? "page" : undefined}>
          Pizarrones
        </a>
        <a href="/escuelas/" aria-current={current === "escuelas" ? "page" : undefined}>
          Escuelas
        </a>
      </nav>
    </header>
    <main id="contenido" class="site-main">
      <slot />
    </main>
  </body>
</html>
