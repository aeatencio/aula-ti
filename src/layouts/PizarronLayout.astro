---
import { navegacionesParaPizarron } from "../data/recorridos";
import Layout from "./Layout.astro";

type EncabezadoVariant =
  | "borde-grande"
  | "borde-chico"
  | "simple-grande"
  | "simple-chico";

interface Props {
  title: string;
  description: string;
  categoria: string;
  encabezado?: EncabezadoVariant;
}

const {
  title,
  description,
  categoria,
  encabezado = "simple-chico",
} = Astro.props;

const tieneSlotEncabezado = Astro.slots.has("encabezado-extra");
const navegaciones = navegacionesParaPizarron(Astro.url.pathname);
---

<Layout
  title={`${title} · Pizarrones · Aula TI`}
  description={description}
  current="pizarrones"
>
  <article class="pizarron">
    <header
      class:list={[
        "pizarron-encabezado",
        `pizarron-encabezado--${encabezado}`,
      ]}
    >
      <p class="ubicacion">Pizarrones · {categoria}</p>
      <h1>{title}</h1>
      {tieneSlotEncabezado && <slot name="encabezado-extra" />}
      {navegaciones.map((navegacion) => (
        <nav
          class="recorrido"
          hidden
          data-recorrido-id={navegacion.id}
          aria-label={`Recorrido ${navegacion.nombre}`}
        >
          <p class="recorrido-contexto">
            Paso {navegacion.paso} de {navegacion.total}
            {" · "}
            <a href={navegacion.href}>{navegacion.nombre}</a>
          </p>
          {(navegacion.anterior || navegacion.siguiente) && (
            <div class="recorrido-vecinos">
              {navegacion.anterior && (
                <a
                  class="recorrido-vecino recorrido-vecino--anterior"
                  href={navegacion.anterior.href}
                  rel="prev"
                  aria-label={`Anterior: ${navegacion.anterior.title}`}
                >
                  ← Anterior
                </a>
              )}
              {navegacion.siguiente && (
                <a
                  class="recorrido-vecino recorrido-vecino--siguiente"
                  href={navegacion.siguiente.href}
                  rel="next"
                  aria-label={`Siguiente: ${navegacion.siguiente.title}`}
                >
                  Siguiente →
                </a>
              )}
            </div>
          )}
        </nav>
      ))}
      {navegaciones.length > 0 && (
        <script is:inline>
          (function () {
            var script = document.currentScript;
            var header = script && script.parentElement;
            if (!header) return;
            var id = new URLSearchParams(window.location.search).get(
              "recorrido",
            );
            if (!id) return;
            var navs = header.querySelectorAll(
              "nav.recorrido[data-recorrido-id]",
            );
            for (var i = 0; i < navs.length; i++) {
              if (navs[i].getAttribute("data-recorrido-id") === id) {
                navs[i].removeAttribute("hidden");
                return;
              }
            }
          })();
        </script>
      )}
    </header>
    <slot />
  </article>
</Layout>

<style>
  .pizarron {
    background: var(--board);
    border: 2px solid var(--line);
    padding: clamp(1.25rem, 3vw, 2.35rem);
  }

  .pizarron-encabezado {
    margin-bottom: 1.15rem;
  }

  .pizarron-encabezado--simple-grande {
    margin-bottom: 1.35rem;
  }

  .pizarron-encabezado--borde-grande {
    margin-bottom: 1.35rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--line);
  }

  .pizarron-encabezado--borde-chico {
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--line);
  }

  .ubicacion {
    margin: 0 0 0.45rem;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .pizarron-encabezado h1 {
    margin: 0;
    font-size: var(--title);
    line-height: 1.15;
  }

  .recorrido {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.15rem;
    margin: 0.7rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .recorrido[hidden] {
    display: none;
  }

  .recorrido-contexto {
    margin: 0;
    overflow-wrap: break-word;
  }

  .recorrido-vecinos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
    margin: 0;
  }

  .recorrido a {
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
  }

  .recorrido a:hover {
    color: var(--accent);
  }

  .recorrido-vecino {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.35rem 0.15rem;
  }

  .recorrido-vecino--siguiente {
    margin-inline-start: auto;
  }
</style>
